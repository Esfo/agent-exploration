# Runtime state and generated artifacts
runtime/state.sqlite*
runtime/config_cache.json
logs/*.jsonl

# Everything generated at runtime: the recursive log tree, sandbox scratch, and
# the results library. Nothing under these is tracked.
workspace/primary/**
workspace/.sandbox/**
workspace/results/**
# ...but keep the directory placeholders so the tree exists after clone.
!**/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
