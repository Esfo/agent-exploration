# ==================================================
# MAIN SETTINGS CONTROL FILE
# ==================================================

RUNTIME_NAME=recursive_local_swarm

# Ollama endpoints (GPU/CPU routing per role below).
OLLAMA_GPU_ENDPOINT=http://localhost:11434
OLLAMA_CPU_ENDPOINT=http://localhost:11434

# The model every role uses unless its DEFAULT_<ROLE>_MODEL below is set to a real
# model name. Each per-role line is left as <PLACEHOLDER_OLLAMA_MODEL>, which means
# "fall back to DEFAULT_MODEL" — replace any of them to give that agent its own
# model. So you only need one model pulled to start.
DEFAULT_MODEL=qwen2.5-coder:7b
DEFAULT_PRIMARY_MODEL=<PLACEHOLDER_OLLAMA_MODEL>
DEFAULT_CODE_MODEL=<PLACEHOLDER_OLLAMA_MODEL>
DEFAULT_MATH_MODEL=<PLACEHOLDER_OLLAMA_MODEL>
DEFAULT_OPTIMIZATION_MODEL=<PLACEHOLDER_OLLAMA_MODEL>
DEFAULT_PHILOSOPHER_MODEL=<PLACEHOLDER_OLLAMA_MODEL>
DEFAULT_TESTER_MODEL=<PLACEHOLDER_OLLAMA_MODEL>
DEFAULT_ZIPPER_MODEL=<PLACEHOLDER_OLLAMA_MODEL>

# Context / output / temperature. Per-role NUM_PREDICT / TEMPERATURE override the
# DEFAULT_* values below; everything else falls back to them.
DEFAULT_NUM_CTX=8192
DEFAULT_NUM_PREDICT=2048
DEFAULT_TEMPERATURE=0.3

PRIMARY_NUM_PREDICT=4096
PRIMARY_TEMPERATURE=0.4
CODE_NUM_PREDICT=4096
CODE_TEMPERATURE=0.15
MATH_TEMPERATURE=0.2
OPTIMIZATION_NUM_PREDICT=4096
OPTIMIZATION_TEMPERATURE=0.15
PHILOSOPHER_TEMPERATURE=0.3
TESTER_TEMPERATURE=0.1
ZIPPER_NUM_PREDICT=1024
ZIPPER_TEMPERATURE=0.0

# Routing: which roles run on the GPU endpoint vs the CPU endpoint.
ROUTE_PRIMARY_TO_GPU=true
ROUTE_CODE_TO_GPU=true
ROUTE_MATH_TO_GPU=false
ROUTE_OPTIMIZATION_TO_GPU=true
ROUTE_PHILOSOPHER_TO_GPU=false
ROUTE_TESTER_TO_GPU=false
ROUTE_ZIPPER_TO_GPU=false

# Summarize-on-overflow: when an agent's history exceeds its context budget, the
# oldest turns are compressed into a briefing (top-down) and the latest context is
# kept verbatim. SUMMARIZE_RECENT_FRACTION is how much of the budget to reserve
# for the kept-verbatim recent turns. Summarization uses the agent's own model.
SUMMARIZE_ON_OVERFLOW=true
SUMMARIZE_RECENT_FRACTION=0.5
TOKEN_SAFETY_MARGIN=256

# Live display: stream the running model's output into a pinned buffer at the
# bottom of the terminal, with one-line notices scrolling above it. Off-TTY this
# is ignored and output is plain.
LIVE_DISPLAY=true
LIVE_BUFFER_LINES=3

# Convergence / recursion bounds.
# A council loops response->vote until every member votes FINISHED; this is the
# safety bound that force-resolves the loop so it can never run unbounded.
CONVERGENCE_MAX_ROUNDS=6
# How deep a member's EXPANSION -> SPAWN sub-councils may recurse.
MAX_SUBSWARM_DEPTH=4

# Write each agent's full conversation to a text file named by its unique id,
# inside its council folder (a recursive tree under PRIMARY_DIR), plus a per-council
# votes log. Rewritten as the conversation grows.
WRITE_TRANSCRIPTS=true

# Directories
INSTRUCTIONS_DIR=instructions
# Root of the recursive log tree: primary.txt + councils/council1/<agent-id>.txt …
PRIMARY_DIR=workspace/primary
# Hidden scratch for sandbox code execution (one dir per agent, not in the log tree).
SANDBOX_WORKDIR=workspace/.sandbox
RESULTS_DIR=workspace/results
LOG_DIR=logs

# Sandbox (the only official tool: run/test code for the coding/testing/
# optimization/math agents). Build the hardened image with `--initiate`.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=recursive-local-swarm-sandbox:latest
# Require Docker for code execution. If Docker is unavailable, code execution is
# DISABLED rather than silently running on your host. Set to false only if you
# accept agent code running on the host (rlimits only, NOT isolated).
SANDBOX_REQUIRE_DOCKER=true
# Keep ONE warm container for the whole session (mounts the agents root, each run
# execs into that agent's subdir) instead of spinning up a throwaway container per
# run (much faster). false = throwaway `docker run --rm` per execution.
SANDBOX_REUSE_CONTAINER=true
SANDBOX_NETWORK_DEFAULT=none
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=256
SANDBOX_READ_ONLY_ROOT=true
MAX_FILE_WRITE_MB=5
